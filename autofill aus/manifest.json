{
  "manifest_version": 3,
  "name": "Autofill úc",
  "version": "1.0.0",
  "description": "UserScript manager - Quản lý và tự động chạy script trên trình duyệt",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://online.immi.gov.au/*"],
      "js": ["immi-autofill.js"],
      "run_at": "document_end",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://online.immi.gov.au/*"],
      "js": ["immi-filler.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
