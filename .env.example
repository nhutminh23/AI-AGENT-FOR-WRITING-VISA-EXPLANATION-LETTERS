# ============================================
# Environment Variables (.env)
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# OpenAI API key (required for OCR, translation, letter writing, etc.)
OPENAI_API_KEY=sk-...

# SerpAPI key (required for flight search)
SERPAPI_KEY=

# AI models (cost-safe defaults)
# Preferred keys:
OPENAI_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Legacy aliases still supported by config.py (optional)
# TEXT_MODEL=gpt-5-mini
# VISION_MODEL=gpt-4o-mini
